{
  "name": "battyflow",
  "version": "0.2.0",
  "description": "Offline push-to-talk dictation for Windows. Hold a key, talk, and the text is typed where your cursor is. Runs whisper.cpp locally.",
  "author": "Arjun Shukla <arjunshuklacse@gmail.com>",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "dist/main/app.cjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "smoke": "node scripts/smoke.mjs",
    "fixtures": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/synthetic-fixtures.ps1 && node scripts/finalize-fixtures.mjs",
    "benchmark": "tsx benchmark/run.ts",
    "icons": "node scripts/render-icons.mjs",
    "package": "npm run build && electron-builder --win nsis portable --x64 --publish never",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "electron": "44.3.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "playwright": "1.58.2",
    "prettier": "3.9.9",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  },
  "build": {
    "appId": "org.battyflow.desktop",
    "productName": "BattyFlow",
    "copyright": "Copyright © 2026 Arjun Shukla",
    "asar": true,
    "asarUnpack": [
      "dist/native/**/*"
    ],
    "files": [
      "dist/**/*",
      "package.json",
      "LICENSE"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.ico",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "BattyFlow-Setup-${version}.${ext}",
      "shortcutName": "BattyFlow",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true
    },
    "portable": {
      "artifactName": "BattyFlow-${version}-portable.${ext}"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "BattyFlow records speech to transcribe it on this computer."
      }
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility"
    }
  },
  "homepage": "https://github.com/ArjunShuklaCSE/BattyFlow",
  "repository": {
    "type": "git",
    "url": "https://github.com/ArjunShuklaCSE/BattyFlow.git"
  }
}
