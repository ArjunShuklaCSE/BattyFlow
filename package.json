{
  "name": "battyflow",
  "version": "0.1.0",
  "description": "Private local desktop dictation for developers",
  "author": "BattyFlow contributors",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "dist/main/app.cjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "start": "npm run build && electron .",
    "test:desktop": "node scripts/desktop-smoke.mjs",
    "package": "npm run build && electron-builder --win portable --x64",
    "benchmark": "tsx benchmark/run.ts",
    "fixtures:synthetic": "powershell.exe -NoProfile -File scripts/synthetic-fixtures.ps1"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "electron": "44.3.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "playwright": "1.58.2",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  },
  "build": {
    "appId": "org.battyflow.desktop",
    "productName": "BattyFlow",
    "asar": true,
    "asarUnpack": ["dist/native/**/*"],
    "files": ["dist/**/*", "package.json", "LICENSE", "docs/**/*"],
    "directories": { "output": "release" },
    "win": { "target": ["portable"], "icon": "assets/icon.ico", "signExecutable": false },
    "mac": { "target": ["dmg"], "category": "public.app-category.productivity", "extendInfo": { "NSMicrophoneUsageDescription": "Record speech for transcription on this computer." } },
    "linux": { "target": ["AppImage"], "category": "Utility" }
  }
}
